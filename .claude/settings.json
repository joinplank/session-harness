      "Bash(gh pr list:*)",
      "Bash(gh repo view:*)",
      "Bash(gh label list:*)",
      "Bash(git clone:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
